          "step": 1
        },
        "oversold": {
          "type": "int",
          "low": 15,
          "high": 40,
          "step": 1
        }
      }
    },
    "ema_cross": {
      "function": "ma_crossover",
      "inputs": {
        "fast_ma": "ema_fast",
        "slow_ma": "ema_slow"
      },
      "params": {}
    },
    "sma_cross": {
      "function": "ma_crossover",
      "inputs": {
        "fast_ma": "sma_fast",
        "slow_ma": "sma_slow"
      },
      "params": {}
    },
    "rsi_trend_combo": {
      "function": "rsi_mean_reversion_with_trend",
      "inputs": {
        "rsi": "rsi_main",
        "ema_fast": "ema_fast",
        "ema_slow": "ema_slow"
      },
      "params": {
        "overbought": {
          "type": "int",
          "low": 65,
          "high": 85,
          "step": 1
        },
        "oversold": {
          "type": "int",
          "low": 15,
          "high": 40,
          "step": 1
        }
      }
    }
  },
  "signal_combination_methods": [
    "majority_vote",
    "and_signals",
    "unanimous"
  ]
