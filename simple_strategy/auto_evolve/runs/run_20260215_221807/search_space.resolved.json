          "type": "int",
          "low": 7,
          "high": 28,
          "step": 1
        }
      }
    },
    "ema_fast": {
      "function": "ema",
      "params": {
        "period": {
          "type": "int",
          "low": 5,
          "high": 40,
          "step": 1
        }
      }
    },
    "ema_slow": {
      "function": "ema",
      "params": {
        "period": {
          "type": "int",
          "low": 20,
          "high": 140,
          "step": 1
        }
      }
    },
    "sma_fast": {
      "function": "sma",
      "params": {
        "period": {
          "type": "int",
          "low": 5,
          "high": 50,
          "step": 1
        }
      }
    },
    "sma_slow": {
      "function": "sma",
      "params": {
